{
  "name": "mesa-de-ayuda-backend",
  "version": "1.0.0",
  "description": "Backend API REST segura para Mesa de Ayuda",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:groq": "tsx scripts/test-groq-real.ts",
    "test:db": "tsx scripts/test-db-connection.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "security:check": "tsx scripts/security-check.ts",
    "security:secrets": "tsx scripts/secrets-scan.ts",
    "history:cleanup:dry-run": "tsx scripts/history-cleanup.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "zod",
    "helmet",
    "rate-limit",
    "mesa-de-ayuda"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
