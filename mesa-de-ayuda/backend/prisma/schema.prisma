datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AiAction {
  CORRECT
  PARAPHRASE
  PROFESSIONALIZE
  SUMMARIZE
  REPLY
}

enum Tone {
  PROFESSIONAL
  FORMAL
  FRIENDLY
  TECHNICAL
  CASUAL
}

enum ParaphraseLevel {
  SOFT
  MEDIUM
  COMPLETE
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  displayName        String
  passwordHash       String
  role               UserRole      @default(USER)
  status             UserStatus    @default(ACTIVE)
  mustChangePassword Boolean       @default(true)
  monthlyTokenLimit  Int?
  saveAiHistory      Boolean       @default(true)
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  aiHistories  AiHistory[]
  libraryItems LibraryItem[]
  quickTexts   QuickText[]
  sessions     AuthSession[]
  auditLogs    AuditLog[]

  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  familyId   String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("auth_sessions")
}

model Category {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  libraryItems LibraryItem[]

  @@map("categories")
}

model LibraryItem {
  id         String   @id @default(uuid())
  userId     String?
  categoryId String
  title      String
  content    String   @db.Text
  isShared   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([categoryId])
  @@index([isShared])
  @@index([isFavorite])
  @@index([createdAt])
  @@map("library_items")
}

model AiHistory {
  id              String          @id @default(uuid())
  userId          String?
  action          AiAction
  originalText    String?         @db.Text
  resultText      String?         @db.Text
  tone            Tone            @default(PROFESSIONAL)
  paraphraseLevel ParaphraseLevel @default(MEDIUM)
  model           String          @default("llama-3.1-8b-instant")
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  latencyMs       Int?
  createdAt       DateTime        @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([action])
  @@map("ai_histories")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

model QuickText {
  id        String   @id @default(uuid())
  userId    String
  title     String
  header    String   @db.Text
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("quick_texts")
}
