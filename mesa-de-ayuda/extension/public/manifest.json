{
  "manifest_version": 3,
  "name": "Mesa de Ayuda",
  "version": "1.0.0",
  "description": "Asistente de redacción para soporte técnico",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "Abrir Mesa de Ayuda",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
