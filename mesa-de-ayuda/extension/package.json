{
  "name": "mesa-de-ayuda-extension",
  "version": "1.1.0",
  "description": "Extensión de Chrome para asistencia de soporte técnico - Mesa de Ayuda",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build --mode production",
    "build:dev": "tsc --noEmit && vite build --mode development",
    "release": "npx tsx scripts/build-release.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "side-panel",
    "mesa-de-ayuda"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
